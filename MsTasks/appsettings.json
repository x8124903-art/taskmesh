{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Type": "MySql",
    "DefaultConnection": "[configurar]"
  },
  "RedisCache": {
    "ConnectionString": "[configurar]",
    "InstanceName": "TaskMesh",
    "Enabled": false,
    "ConnectRetry": 3,
    "AbsoluteExpirationInMinutes": 20
  },
  "MsProjects": {
    "BaseUrl": "[configurar]"
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/MsTasks-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "ApplicationName": "MsTasks"
    }
  }
}
