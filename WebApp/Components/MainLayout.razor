@namespace WebApp.Components
@inherits LayoutComponentBase
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (AuthService.IsAuthenticated)
    {
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                           Color="Color.Inherit" 
                           Edge="Edge.Start" 
                           OnClick="@ToggleDrawer" />
            <MudText Typo="Typo.h6">TaskMesh</MudText>
            <MudSpacer />
            <MudText Typo="Typo.body1" Class="ml-4 mr-4">@AuthService.CurrentUser?.Name</MudText>
            <NotificationBell />
            <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" 
                           Color="Color.Inherit" 
                           OnClick="@ToggleUserMenu" />
            @if (_userMenuOpen)
            {
                <MudOverlay Visible="true" OnClick="@(() => _userMenuOpen = false)" 
                            LockScroll="false" DarkBackground="false" 
                            Style="z-index: 1299; background: transparent;" />
                <MudPopover Open="@_userMenuOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" 
                            Style="width: 220px;">
                    <MudPaper Elevation="4" Class="pa-0">
                        <MudList Clickable="true" Dense="true">
                            <MudListItem Icon="@Icons.Material.Filled.Logout" OnClick="@Logout">
                                Cerrar Sesión
                            </MudListItem>
                        </MudList>
                    </MudPaper>
                </MudPopover>
            }
        </MudAppBar>
        
        <MudDrawer @bind-Open="@_drawerOpen" Elevation="1" ClipMode="@DrawerClipMode.Always">
            <MudNavMenu>
                <MudNavLink Href="/projects" 
                            Icon="@Icons.Material.Filled.Folder" 
                            Match="NavLinkMatch.Prefix">
                    Proyectos
                </MudNavLink>
                <MudNavLink Href="/invitations" 
                            Icon="@Icons.Material.Filled.Mail">
                    Invitaciones
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-4">
                @Body
            </MudContainer>
        </MudMainContent>
    }
    else
    {
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
                @Body
            </MudContainer>
        </MudMainContent>
    }
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _userMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleUserMenu()
    {
        _userMenuOpen = !_userMenuOpen;
    }

    private async Task Logout()
    {
        _userMenuOpen = false;
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
