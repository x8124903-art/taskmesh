@using WebApp.Models.Projects

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            Cambiar rol de <strong>@Member.UserName</strong>
        </MudText>
        
        <MudRadioGroup @bind-Value="@selectedRole">
            <MudRadio Value="@("Admin")" Color="Color.Warning">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" Size="Size.Small" />
                    <MudText>Admin</MudText>
                </MudStack>
            </MudRadio>
            <MudRadio Value="@("Member")" Color="Color.Default">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Default" Size="Size.Small" />
                    <MudText>Member</MudText>
                </MudStack>
            </MudRadio>
            <MudRadio Value="@("Viewer")" Color="Color.Default">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Default" Size="Size.Small" />
                    <MudText>Viewer</MudText>
                </MudStack>
            </MudRadio>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit"
                   Disabled="@(selectedRole == Member.RoleName)">
            Cambiar Rol
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProjectMember Member { get; set; } = default!;

    private string selectedRole = string.Empty;

    protected override void OnInitialized()
    {
        selectedRole = Member.RoleName;
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(selectedRole));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
