@page "/login"
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudPaper Class="pa-4 mx-auto mt-8" Style="max-width:400px;">
    <MudText Typo="Typo.h5" Class="mb-4">Iniciar sesión</MudText>
    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
        <MudTextField @bind-Value="loginModel.Email" Label="Email" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="loginModel.Password" Label="Contraseña" Variant="Variant.Outlined" InputType="InputType.Password" Required="true" Class="mb-3" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Entrar</MudButton>
    </EditForm>
    @if (loginFailed)
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">Login incorrecto</MudAlert>
    }
    <MudText Class="mt-3" Align="Align.Center">
        ¿No tienes cuenta? <MudLink Href="/register">Regístrate</MudLink>
    </MudText>
</MudPaper>

@code {
    private LoginModel loginModel = new();
    private bool loginFailed = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.EnsureInitializedAsync();
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/projects");
        }
    }

    private async Task HandleLogin()
    {
        loginFailed = false;
        var success = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
        if (success)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            loginFailed = true;
        }
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
