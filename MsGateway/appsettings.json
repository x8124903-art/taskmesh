{
  "Jwt": {
    "SecretKey": "super-secret-key-change-in-production-min-256-bits",
    "Issuer": "taskmesh-auth",
    "Audience": "taskmesh-api"
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-public-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{action}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "auth-public-route-v1.0": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1.0/auth/{action}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1.0" }
        ],
        "Metadata": {
          "AllowAnonymous": "true"
        }
      },
      "auth-protected-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "auth-protected-route-v1.0": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1.0/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1.0" }
        ]
      },
      "projects-route": {
        "ClusterId": "projects-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1/projects/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "projects-route-v1.0": {
        "ClusterId": "projects-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1.0/projects/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1.0" }
        ]
      },
      "invitations-route": {
        "ClusterId": "projects-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1/invitations/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "invitations-route-v1.0": {
        "ClusterId": "projects-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1.0/invitations/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1.0" }
        ]
      },
      "tasks-route": {
        "ClusterId": "tasks-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1/tasks/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "tasks-route-v1.0": {
        "ClusterId": "tasks-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1.0/tasks/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1.0" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "notifications-route-v1.0": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "RequireAuthentication",
        "Match": {
          "Path": "/api/v1.0/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1.0" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://msauth:8080"
          }
        }
      },
      "projects-cluster": {
        "Destinations": {
          "projects-service": {
            "Address": "http://msprojects:8080"
          }
        }
      },
      "tasks-cluster": {
        "Destinations": {
          "tasks-service": {
            "Address": "http://mstasks:8080"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-service": {
            "Address": "http://msnotifications:8080"
          }
        }
      }
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ms-gateway-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"],
    "Properties": {
      "ApplicationName": "ms-gateway"
    }
  }
}
