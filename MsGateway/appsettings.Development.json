{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5310"
          }
        }
      },
      "projects-cluster": {
        "Destinations": {
          "projects-service": {
            "Address": "http://localhost:44311"
          }
        }
      }
    }
  }
}
