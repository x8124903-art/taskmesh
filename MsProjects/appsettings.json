{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Type": "MySql",
    "DefaultConnection": "server=localhost;uid=root;pwd=secret;database=taskmesh_projects"
  },
  "Jwt": {
    "SecretKey": "super-secret-key-change-in-production-min-256-bits",
    "Issuer": "taskmesh-auth",
    "Audience": "taskmesh-api"
  },
  "EventBus": {
    "ConnectionString": "amqp://taskmesh:TaskMesh2024!@localhost:5672"
  },
  "MsAuth": {
    "BaseUrl": "http://localhost:44310"
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ms-projects-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"],
    "Properties": {
      "ApplicationName": "ms-projects"
    }
  }
}
