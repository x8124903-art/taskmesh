{
  "Jwt": {
    "SecretKey": "super-secret-key-change-in-production-min-256-bits",
    "Issuer": "taskmesh-auth",
    "Audience": "taskmesh-api",
    "AccessTokenExpirationMinutes": 15
  },
  "Database": {
    "Type": "MySql",
    "DefaultConnection": "server=localhost;uid=root;pwd=TaskMesh2024!;database=taskmesh_auth"
  },
  "EventBus": {
    "ConnectionString": "amqp://taskmesh:TaskMesh2024!@localhost:5672"
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ms-auth-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"],
    "Properties": {
      "ApplicationName": "ms-auth"
    }
  }
}
